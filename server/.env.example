# =============================================================
#  Настройки сервера-моста MariaDB <-> Roblox Studio
# =============================================================

# --- HTTP ---
PORT=3000

# Необязательно. Если задать — все эндпоинты кроме / и /health
# потребуют заголовок x-api-key. Для локальной разработки можно оставить пустым.
API_KEY=

# Максимальный размер JSON-тела запроса.
BODY_LIMIT=128kb

# Лимит запросов в минуту с одного IP (защита от спама и DoS)
RATE_LIMIT_MAX=300

# --- MariaDB / MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=roblox_db
DB_POOL=10

# --- Журнал аудита ---
# true — каждое изменение пишется в таблицу player_log.
LOG_ENABLED=true